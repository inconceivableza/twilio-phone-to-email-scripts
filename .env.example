# Non-secret configuration (credentials belong in .secrets or env vars)
#
# Credentials: set via environment variables or .secrets file
# See README for API key creation instructions per region.
#
# Recommended (API keys per region):
#   API_KEY_SID_US1=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   API_KEY_SECRET_US1=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   API_KEY_SID_IE1=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   API_KEY_SECRET_IE1=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Alternative (auth tokens per region):
#   AUTH_TOKEN_US1=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   AUTH_TOKEN_IE1=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Always needed:
#   ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   MAILJET_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   MAILJET_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default regions for phone numbers
VOICE_REGION=us1
SMS_REGION=us1

# Email configuration (optional — leave blank to skip email forwarding)
FORWARDING_EMAIL=
FROM_EMAIL=

# Voicemail greeting (optional)
ANSWER_MESSAGE_URL=
ANSWER_MESSAGE_NAME=
THANK_YOU_MESSAGE_URL=

# SIP configuration (optional — leave blank to skip SIP)
SIP_DOMAIN=
SIP_INBOUND=true
SIP_DIAL_TIMEOUT=20

# SMS forwarding (optional — leave blank to skip)
SMS_FORWARD_NUMBER=
